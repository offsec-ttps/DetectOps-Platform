# ─────────────────────────────────────────────────────────────────────────────
# DetectOps Platform — environment configuration
#
# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
# Only the Core section is required to boot; everything else enables a feature.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (required) ──────────────────────────────────────────────────────────
# SQLite by default; point at Postgres/etc. if you change the Prisma datasource.
DATABASE_URL="file:./dev.db"
# Stable 32+ char secret used to encrypt credentials/tokens AT REST (fleet keys,
# cloud creds, integration secrets). MUST be set and persistent — if it changes,
# previously-encrypted values become unreadable. Generate once:
#   openssl rand -hex 32
CREDENTIAL_VAULT_KEY="change-me-generate-with-openssl-rand-hex-32"
# "production" enables auth enforcement + HSTS. Leave unset for local dev.
# NODE_ENV=production

# ── Authentication & access control ──────────────────────────────────────────
# Force login/session enforcement even outside production (1 = on).
# AUTH_ENFORCE=1
# Comma-separated emails that are granted the admin role. REQUIRED in production
# or no one can administer the platform.
ADMIN_EMAILS="you@example.com"
# Self-signup policy (closed by default in production). Open with either:
# ALLOW_SIGNUP=1
# SIGNUP_ALLOWED_DOMAINS="example.com,corp.example.com"
# Number of trusted reverse-proxy hops in front of the app. Login/signup read the
# client IP this many entries from the RIGHT of X-Forwarded-For. Set it to match
# your deployment (e.g. 1 behind a single nginx). 0/absent = no proxy trusted.
TRUSTED_PROXY_HOPS=1

# ── LLM providers (optional — for AI-assisted generation features) ────────────
LLM_PROVIDER_DEFAULT="openrouter"
# LLM_PROVIDER_FALLBACK="ollama"
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL_DEFAULT="gpt-4o-mini"
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL_DEFAULT="claude-sonnet-5-5"
# OPENROUTER_API_KEY="sk-or-..."
# OPENROUTER_MODEL_DEFAULT="..."
# NVIDIA_API_KEY=""
# OLLAMA_HOST="http://localhost:11434"
# OLLAMA_MODEL_DEFAULT="llama3.1"
# Cost/size guards.
# Rule-review & recommendation agent — model for reviewing failed/undetected
# sims and proposing detections. Set a compact, security-tuned/low-cost model
# here (keeps token I/O low); defaults to the provider's default model.
# RULE_REVIEW_MODEL=""
# LLM_MAX_OUTPUT_TOKENS=32768
# LLM_MAX_INPUT_CHARS=600000
# Allow LLM calls to loopback (e.g. local Ollama) when auth is enforced.
# LLM_ALLOW_LOOPBACK=1

# ── Labs / simulation hosts ───────────────────────────────────────────────────
# Extra roots (colon-separated) where lab deployments may live, in addition to
# ./labs and ~/.detectops-labs. Keep deployments OUTSIDE the project dir in dev
# to avoid the file-watcher reload loop (or use `npm run dev`, which is webpack
# with those paths already watch-ignored).
# LAB_DEPLOY_ROOTS="/mnt/data/detection-labs"
# Source paths for the bundled SAR / GOAD blueprints.
# SAR_PATH="/path/to/attack_range_local"
# GOAD_PATH="/path/to/GOAD"
# SAR Splunk override used by lab validation/status probes (defaults shown).
# SAR_SPLUNK_URL="https://10.0.1.12:8089"
# SAR_SPLUNK_USER="admin"
# SAR_SPLUNK_PASSWORD=""
# PEM/CA bundle to VERIFY self-signed lab TLS instead of skipping verification.
# LAB_TLS_CA_FILE="/path/to/lab-ca.pem"
# Allow outbound lab calls to loopback when auth is enforced.
# OUTBOUND_ALLOW_LOOPBACK=1
# Python used for the WinRM exec + report helpers (must have pywinrm/deps).
# WINRM_PYTHON="python3"

# ── SIEM / HEC replay (optional) ──────────────────────────────────────────────
# SPLUNK_HOST="10.0.1.12"
# SPLUNK_HEC_PORT="8088"
# SPLUNK_HEC_TOKEN=""

# ── Threat intelligence / collectors (optional) ───────────────────────────────
# THREADLINQS_API_KEY=""
# RANSOMWARE_LIVE_API_KEY=""
# ENABLE_RANSOMWARE_INTEL=1
# ENABLE_COLLECTOR_RANSOMWATCH=1
# ENABLE_COLLECTOR_RANSOMWARE_LIVE=1
# Tor collector (needs an HTTP bridge to the SOCKS proxy).
# ENABLE_TOR_COLLECTOR=1
# TOR_HTTP_PROXY="http://127.0.0.1:8118"
# Bearer token the TI-watcher cron presents to /api/ti-watcher/scan.
# WATCHER_TOKEN=""

# ── Reporting toolchain (optional — report rendering) ─────────────────────────
# REPORT_PYTHON="python3"
# PANDOC_BIN="pandoc"
# SOFFICE_BIN="libreoffice"
# SIGMA_CLI_PATH="sigma"


# ── Replay Catalog (optional — log-replay datasets, no endpoint simulation) ───
# Local clone of the Splunk attack_data repo (metadata is small; log files are
# Git-LFS — clone with GIT_LFS_SKIP_SMUDGE=1 then `git lfs pull --include=<file>`
# per dataset before replaying). The target index must exist on Splunk.
# ATTACK_DATA_ROOT="/path/to/attack_data"
# SPLUNK_HEC_PORT="8088"
# SPLUNK_HEC_TOKEN=""

# ── Build Forge (optional) ────────────────────────────────────────────────────
# A GitHub token for higher-rate release/asset fetches (read-only scope is fine).
# GITHUB_TOKEN=""
# BUILD_FORGE_MAX_ASSET_BYTES=524288000

# ── MCP detection-content server (optional) ───────────────────────────────────
# MCP_PUBLIC_BASE_URL="http://localhost:3000"

# ── Dev server / build tooling (read by next.config.ts, not app runtime) ──────
# Extra origins allowed to hit the dev server cross-origin (HMR) besides
# localhost — e.g. a LAN IP or the server's public IP. Comma-separated.
# ALLOWED_DEV_ORIGINS="192.168.1.50,10.0.0.5"
# Override the Turbopack project root (defaults to the current working dir).
# Only needed if you run the dev server from outside the repo checkout.
# TURBOPACK_ROOT=""
# Docs site (start-docs.sh). Default binds 127.0.0.1:8000 (not reachable off-box);
# set DOCS_HOST=0.0.0.0 to expose it on the LAN / server IP.
# DOCS_HOST="127.0.0.1"
# DOCS_PORT="8000"

# ── Tooling/ops (NOT read by the app) ─────────────────────────────────────────
# Token used by the repo's push helper only. Do not rely on this for app auth.
# GITHUB_CREDS=""

# ── Scheduled content sync (config/sync-jobs.json) ───────────────────────────
# Token the sync scheduler + *-tick routes use to authenticate internal/cron
# calls (also lets an external cron drive /api/sync/tick). Set a random value.
# INTERNAL_WORKER_TOKEN=""
# SYNC_BASE_URL="http://127.0.0.1:3000"   # override if the app is not on :3000
