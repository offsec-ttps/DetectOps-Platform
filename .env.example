# ============================================================================
# DetectOps environment configuration
# Copy to .env and fill in what you need. Almost everything is optional and
# gates a specific feature; the app boots with just DATABASE_URL. Many
# integrations are ALSO configurable in the Settings UI (secrets encrypted at
# rest), which wins over these vars on name collision.
# Full reference: docs/getting-started/configuration.md
# ============================================================================

# ── Database ────────────────────────────────────────────────────────────────
# SQLite detection database (community rules, IOCs, threat intel, mcp_api_keys).
DATABASE_URL=file:./dev.db

# ── Auth & security ─────────────────────────────────────────────────────────
# When true, dashboard/admin routes require a real session; when false (dev) a
# synthetic admin is used. The public /api/mcp endpoint is ALWAYS key-gated.
AUTH_ENFORCED=false
# 32+ char key that durably encrypts cloud credentials + integration tokens at
# rest. Set this BEFORE storing cloud creds you want to survive restarts.
# CREDENTIAL_VAULT_KEY=
# Shared secret for internal background-worker endpoints (*/tick).
# INTERNAL_WORKER_TOKEN=
# Set to "self-hosted" to enable the Local Lab deploy option.
# PLATFORM_MODE=self-hosted

# ── MCP server (this platform's own server at /api/mcp) ─────────────────────
ENABLE_MCP_SERVER=true
MCP_PUBLIC_BASE_URL=http://localhost:3000

# ── MCP client (outbound enrichment) ────────────────────────────────────────
# Other MCP servers to query for context during detection-pack generation.
# Prefer the Settings UI at /settings/mcp-servers (DB-backed, encrypted).
# Semicolon-separated: name=transport:address[|option=value,...]
# transport is "stdio" (address = command) or "http" (address = URL). A "token"
# option is sent as "Authorization: Bearer <token>" for http servers.
# MCP_SERVERS="virustotal=stdio:/usr/local/bin/mcp-virustotal;misp=http:http://misp.local/mcp|token=abc123"

# ── LLM providers ───────────────────────────────────────────────────────────
# Powers SigmaGen AI, Detection Packs, and AI assistants. Configure at least one.
# Default resolves via LLM_PROVIDER_DEFAULT, else: anthropic > openai >
# openrouter > nvidia > ollama (ollama last so a local daemon isn't auto-chosen).
# LLM_PROVIDER_DEFAULT=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_DEFAULT=
# OPENAI_API_KEY=
# OPENAI_MODEL_DEFAULT=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL_DEFAULT=
# OPENROUTER_APP_NAME=
# OPENROUTER_APP_URL=
# NVIDIA_API_KEY=
# NVIDIA_MODEL_DEFAULT=
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL_DEFAULT=

# ── SigmaGen search & Sigma CLI ─────────────────────────────────────────────
# SIGMAGEN_SEARCH_PROVIDER=
# BRAVE_SEARCH_API_KEY=
# SEARXNG_URL=
# Override the Sigma CLI binary (defaults to backend/.venv/bin/sigma).
# SIGMA_CLI_PATH=

# ── Detection-pack pipeline (LLM budget guard) ──────────────────────────────
# DETECTION_PACK_DAILY_TOKEN_BUDGET=
# DETECTION_PACK_PER_JOB_ESTIMATE=

# ── GitHub / detection-as-code ──────────────────────────────────────────────
# GITHUB_TOKEN=
# LINKSEC_BRANCH=
# CORE_VERSION=

# ── Reports ─────────────────────────────────────────────────────────────────
# Directory where "Save Report Locally" writes the rendered Markdown report.
# If set, reports are saved there; otherwise they default to <cwd>/reports/local.
# Absolute path, or ~ for the home dir (e.g. ~/DetectOps-Reports).
# REPORTS_LOCAL_DIR=

# ── Community-source feature flags (all default on) ─────────────────────────
# ENABLE_COMMUNITY_CONTENT_EXPANSION=true
# ENABLE_MITRE_CAR_SOURCE=true
# ENABLE_MICROSOFT_SENTINEL_SOURCE=true
# ENABLE_DEFENDER_XDR_SOURCE=true
# ENABLE_GOOGLE_SECOPS_SOURCE=true
# ENABLE_PANTHER_SOURCE=true
# ENABLE_FALCO_SOURCE=true
# ENABLE_WAZUH_SOURCE=true
# ENABLE_SIGMA_WORKSPACE_CONVERSION=true

# ── Module Marketplace ──────────────────────────────────────────────────────
# ENABLE_MODULE_MARKETPLACE=true
# ENABLE_MODULE_AUTO_APPROVE=false
# ENABLE_MODULE_SIGNING=false

# ── Ransomware & threat intel ───────────────────────────────────────────────
# ENABLE_RANSOMWARE_INTEL=true
# ENABLE_COLLECTOR_RANSOMWARE_LIVE=false
# ENABLE_COLLECTOR_RANSOMWATCH=false
# RANSOMWARE_LIVE_API_KEY=
# RANSOMWARE_LIVE_BASE=
# RANSOMWATCH_RAW_BASE=
# RANSOMWATCH_SCREENSHOT_BASE=
# RANSOMWATCH_POST_CAP=
# ENABLE_TOR_COLLECTOR=false
# TOR_HTTP_PROXY=
# TOR_SOCKS_PROXY=
# TOR_CRAWL_CAP=

# ── Attack-data replay (Replay Catalog) ─────────────────────────────────────
# ATTACK_DATA_ROOT=
# ENABLE_ATTACK_DATA_REPLAY=false
# ENABLE_REPLAY_BUILD=false
# ENABLE_REPLAY_SAVE_FOR_LATER=false

# ── BAS agent (Remote Fleet) ────────────────────────────────────────────────
# BAS_AGENT_VERSION=
# BAS_AGENT_ARTIFACTS_DIR=
# ed25519 signing key for fleet jobs (inline or path).
# BAS_SIGNING_KEY=
# BAS_SIGNING_KEY_FILE=

# ── Enterprise use-case runner ──────────────────────────────────────────────
# Wall-clock cap per scenario run (ms). Default 300000.
# ENTERPRISE_UC_RUN_TIMEOUT_MS=300000

# ── Cloud detonation (Stratus Red Team) ─────────────────────────────────────
# STRATUS_BIN=
# TARGET=

# ── Detection lab (SAR / GOAD / Splunk) ─────────────────────────────────────
# Paths to the SAR and GOAD source installs used by the Local/Cloud lab flows.
# SAR_PATH=/media/nested/SamsungEvo/Simulation/attack_range_local
# SAR_API_URL=
# GOAD_PATH=/media/nested/SamsungEvo/Projects/GOAD/GOAD
# GOAD_INSTANCE_ID=
# Splunk server used for detection validation + HEC replay.
# SPLUNK_HOST=
# SPLUNK_IP=
# SPLUNK_HEC_PORT=
# SPLUNK_HEC_TOKEN=
