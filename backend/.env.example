# SentinelFlow Backend Configuration

# Splunk Attack Range (SAR) API
SAR_API_URL=http://localhost:4000
SAR_API_KEY=

# Splunk REST API
SPLUNK_URL=https://splunk.internal:8089
SPLUNK_TOKEN=
SPLUNK_VERIFY_SSL=false

# Microsoft Defender for Endpoint (Graph API)
MDE_TENANT_ID=
MDE_CLIENT_ID=
MDE_CLIENT_SECRET=
MDE_AUTHORITY=https://login.microsoftonline.com

# GitHub
GITHUB_TOKEN=
GITHUB_REPO=acme-corp/detection-rules
GITHUB_DEFAULT_BRANCH=main
GITHUB_REVIEWER=

# Pipeline Defaults
DETECTION_WINDOW_MINUTES=10
POLLING_INTERVAL_SECONDS=15
POLLING_TIMEOUT_SECONDS=600

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=info
