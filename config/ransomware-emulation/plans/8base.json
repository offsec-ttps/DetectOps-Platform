{
  "gang": "8base",
  "displayName": "8Base",
  "aliases": [
    "8Base",
    "Phobos affiliate"
  ],
  "status": "disrupted",
  "activeSince": "2022",
  "lineage": "Phobos RaaS affiliate (Phobos 2.9.x with .8base extension); overlaps with RansomHouse leak-site wording; infrastructure seized and leaders arrested in Europol-led operation, February 2025",
  "summary": "8Base surged in mid-2023 as one of the most active double-extortion operations, deploying a customised Phobos encryptor (.8base). Initial access came via phishing that delivered SmokeLoader, which decrypts and loads Phobos in memory, alongside RDP brute-force and purchased access typical of the Phobos ecosystem. Operators used SystemBC for proxied C2, IP scanners and common credential tools (Mimikatz, LaZagne, NirSoft), disabled the firewall, and ran an extensive recovery-inhibition sequence (vssadmin, wmic, wbadmin, bcdedit) before encrypting. Its leak sites were seized and four alleged leaders arrested in February 2025.",
  "uniqueTraits": [
    "SmokeLoader-delivered Phobos payload decrypted and loaded in memory",
    "SystemBC used to proxy and conceal C2",
    "Full Phobos recovery-inhibition chain (wmic, wbadmin delete catalog, vssadmin, bcdedit recoveryenabled no / ignoreallfailures)",
    "Partial encryption of files above ~1.5 MB for speed"
  ],
  "insufficientReporting": false,
