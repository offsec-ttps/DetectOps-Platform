{
  "gang": "Akira",
  "displayName": "Akira",
  "aliases": [
    "Storm-1567",
    "Howling Scorpius",
    "Gold Sahara",
    "Punk Spider"
  ],
  "status": "active",
  "activeSince": "2023",
  "lineage": "Code and personnel overlap with Conti; Megazord (Rust) and Akira_v2 (Linux/ESXi) variants",
  "summary": "Akira targets SMBs and critical infrastructure, overwhelmingly entering through VPN appliances lacking MFA: Cisco ASA/FTD (CVE-2020-3259, CVE-2023-20269) and SonicWall SSL VPN (CVE-2024-40766, 2024-2025 waves). Operators create domain accounts, Kerberoast, dump LSASS via comsvcs, steal Veeam credentials, BYOVD to kill Defender, tunnel with ngrok, exfiltrate via WinRAR/FileZilla/WinSCP/rclone, then encrypt Windows, ESXi, Hyper-V and (2025) Nutanix AHV workloads.",
  "uniqueTraits": [
    "VPN-without-MFA entry: Cisco ASA/FTD CVE-2020-3259/CVE-2023-20269, SonicWall CVE-2024-40766",
    "Veeam Backup & Replication credential theft (CVE-2023-27532 / CVE-2024-40711)",
    "BYOVD with ThrottleStop rwdrv.sys + hlpdrv.sys (2025) and Zemana driver via PowerTool",
    "Attaching domain controller virtual disks to a rogue VM to steal NTDS.dit",
    "Hypervisor targeting: ESXi, Hyper-V and Nutanix AHV encryption"
  ],
  "insufficientReporting": false,
