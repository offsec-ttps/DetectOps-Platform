{
  "gang": "babuk",
  "displayName": "Babuk",
  "aliases": [
    "Babyk",
    "Vasa Locker"
  ],
  "status": "defunct",
  "activeSince": "2020",
  "lineage": "Source code leaked September 2021 and reused by many families (Rorschach/BabLock, RTM Locker, Mario ESXi, Termite, etc.)",
  "summary": "Babuk was a RaaS that emerged in late 2020/early 2021, hitting high-profile targets (e.g. Washington DC Metropolitan Police) before pivoting to pure data extortion and later leaking its builder and source code in 2021. Post-leak, a Babuk-built payload was deployed by the 'Tortilla' actor via ProxyShell exploitation of Exchange, China Chopper web shells, PowerShell/certutil downloaders and process hollowing into AddInProcess32.exe. The locker uses ChaCha8+ECDH, stops backup services, deletes shadow copies and enumerates network shares; later 'Babuk' leak-site rebrands (2025) recycled old data and are not associated with new intrusion tradecraft.",
  "uniqueTraits": [
    "ProxyShell (CVE-2021-34473/34523/31207) exploitation of Exchange followed by China Chopper web shell (Tortilla campaign)",
    "w3wp.exe-spawned obfuscated PowerShell using Invoke-WebRequest and certutil to fetch 'tortilla.exe'",
    "Multi-stage .NET loader injecting the payload into a suspended AddInProcess32.exe (process hollowing) after stripping Mark-of-the-Web",
    "Modified EfsPotato (CVE-2021-36942 / PetitPotam) for privilege escalation",
    "ChaCha8 + ECDH locker with Windows, ESXi and NAS builds; source leak spawned many derivative families"
  ],
  "insufficientReporting": false,
