{
  "gang": "Black Basta",
  "displayName": "Black Basta",
  "aliases": [
    "Storm-1811 (access cluster)",
    "UNC4393"
  ],
  "status": "disrupted",
  "activeSince": "2022",
  "lineage": "Conti splinter; EDR-evasion tooling tied to FIN7; internal chats leaked Feb 2025 and leak site inactive since early 2025, members reportedly moved to other brands",
  "summary": "Black Basta hit 500+ organisations (2022-2024). Early access came via Qakbot malspam; after the 2023 Qakbot takedown affiliates shifted to email bombing followed by phone/Teams help-desk impersonation that talks users into Quick Assist or AnyDesk, plus exploitation of ScreenConnect and other public-facing flaws. Hands-on activity uses BITSAdmin/curl staging, SoftPerfect netscan, Mimikatz, ZeroLogon/NoPac/PrintNightmare, Backstab and custom FIN7-linked EDR killers, PsExec/RDP and rclone before ChaCha20 encryption of Windows and ESXi.",
  "uniqueTraits": [
    "Email bombing + Microsoft Teams/phone help-desk impersonation leading to Quick Assist sessions (Storm-1811)",
    "Qakbot (and later DarkGate/Pikabot) as primary loader",
    "Custom EDR-impairment tool linked to FIN7 developer; Backstab",
    "ZeroLogon/NoPac/PrintNightmare for domain escalation",
    "Early variants reboot into Safe Mode to bypass EDR and set a custom wallpaper"
  ],
  "insufficientReporting": false,
