{
  "gang": "everest",
  "displayName": "Everest",
  "aliases": [],
  "status": "active",
  "activeSince": "2020",
  "lineage": "NCC Group assesses a medium-confidence relationship with Black-Byte ransomware",
  "summary": "Everest has operated since late 2020 as a data-extortion/ransomware group that increasingly acts as an initial access broker, with a strong focus on healthcare. NCC Group's incident response showed access through an insecure external remote service, a hidden PowerShell cradle launching Cobalt Strike, SoftPerfect NetScan discovery, ProcDump LSASS dumps and NTDS.dit theft, RDP lateral movement with compromised accounts, AnyDesk/Splashtop/Atera installed as services, WinRAR staging and exfiltration via Splashtop file transfer, with routine deletion of tools. Later reporting notes Everest openly recruits corporate insiders for network access.",
  "uniqueTraits": [
    "Hybrid model: data extortion plus initial-access brokering; solicits paid corporate insiders for remote access",
    "Triad of commercial RMMs (AnyDesk, Splashtop, Atera) installed as services, with Splashtop file transfer used for exfiltration",
    "SoftPerfect NetScan output staged as subnets.txt / trustdumps.txt in C:\\Users\\Public\\Downloads",
    "ProcDump LSASS dumps and zipped NTDS.dit copies",
    "Disciplined clean-up: tooling, recon output and archives routinely deleted"
  ],
  "insufficientReporting": false,
