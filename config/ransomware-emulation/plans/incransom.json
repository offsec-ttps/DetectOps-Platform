{
  "gang": "incransom",
  "displayName": "INC Ransom",
  "aliases": [
    "INC",
    "Gold IONIC",
    "Vanilla Tempest (affiliate)",
    "Punchbowl"
  ],
  "status": "active",
  "activeSince": "2023",
  "lineage": "Code reportedly sold/rebranded as Lynx in 2024; INC brand continues in parallel",
  "summary": "INC Ransom is a double-extortion operation active since mid-2023 that has hit healthcare, education and government heavily. Access comes from Citrix NetScaler CVE-2023-3519, FortiClient EMS CVE-2023-48788, phishing, IAB-purchased credentials, and (via the Vanilla Tempest affiliate) Gootloader infections. Operators use RDP with valid accounts, AdFind/NetScan discovery, 7-Zip/WinRAR + MEGAsync exfiltration, Defender disablement via SystemSettingsAdminFlows.exe, and deploy the encryptor with WMIC and PsExec renamed winupd.",
  "uniqueTraits": [
    "Citrix NetScaler CVE-2023-3519 and FortiClient EMS CVE-2023-48788 exploitation",
    "Gootloader (Storm-0494) hand-off to Vanilla Tempest, Supper backdoor, AnyDesk and MEGA",
    "SystemSettingsAdminFlows.exe used to disable Windows Defender",
    "PsExec renamed winupd and encryptor run as 'winupd' service (7045); WMIC mass deployment",
    "VeeamCreds credential theft and ProcTerminator process killing"
  ],
  "insufficientReporting": false,
