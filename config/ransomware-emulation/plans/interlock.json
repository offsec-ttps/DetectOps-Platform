{
  "gang": "interlock",
  "displayName": "Interlock",
  "aliases": [
    "Interlock ransomware"
  ],
  "status": "active",
  "activeSince": "2024",
  "lineage": "Talos assesses with low confidence that operators may derive from Rhysida",
  "summary": "Interlock appeared in September 2024 and, unusually, gains access itself rather than via brokers: drive-by downloads from compromised websites serving fake browser or security-software updates, and from 2025 ClickFix/FileFix fake-CAPTCHA lures delivering the Interlock (NodeSnake) RAT. Post-access it runs PowerShell recon, Run-key and Startup persistence, credential stealers (cht.exe, Lumma, Berserk) and a keylogger, Kerberoasting, and moves via RDP, AnyDesk and PuTTY. Data is taken with Azure Storage Explorer/AzCopy and WinSCP before Windows, Linux and FreeBSD encryptors (focused on virtual machines) are launched, with the ransom note pushed by GPO.",
  "uniqueTraits": [
    "Self-sourced initial access: drive-by fake Chrome/Edge/FortiClient/GlobalProtect updates",
    "ClickFix and FileFix fake-CAPTCHA paste-and-run PowerShell lures (2025)",
    "Interlock/NodeSnake RAT (Node.js, later PHP) using Cloudflare Tunnel (trycloudflare) for C2",
    "Exfiltration to attacker Azure blobs with Azure Storage Explorer / AzCopy",
    "Encryptor masquerading as conhost.exe and DLL run via rundll32 (tmp41.wasd)"
  ],
  "insufficientReporting": false,
