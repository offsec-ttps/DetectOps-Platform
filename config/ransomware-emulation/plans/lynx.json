{
  "gang": "lynx",
  "displayName": "Lynx",
  "aliases": [
    "INC Ransom rebrand"
  ],
  "status": "active",
  "activeSince": "2024",
  "lineage": "Successor/rebrand of INC Ransom (shares ~70% function similarity with INC code)",
  "summary": "Lynx is a RaaS that appeared in July 2024 as the code successor of INC Ransom, with Windows and ESXi encryptors. Affiliates mostly use valid credentials: phished or brute-forced VPN accounts, SSL VPNs with permissive LDAP (any domain user can log in), RMM consoles without MFA and exposed RDP. Intrusions are hands-on and LOTL-heavy: SoftPerfect NetScan, look-alike domain admin accounts, NetExec, RDP to hypervisors and backup servers, 7-Zip + temp.sh exfiltration, then Veeam job deletion before running the encryptor.",
  "uniqueTraits": [
    "Initial access via SSL VPN with permissive LDAP and MFA-less RMM client accounts",
    "Look-alike privileged accounts (e.g. 'administratr') added to Domain Admins and Group Policy Creator Owners",
    "Exfiltration of 7-Zip archives to temp.sh; also MEGAsync/WinSCP/Rclone",
    "Deletes Veeam Backup & Replication jobs from the console before deploying w.exe --mode fast",
    "Encryptor enables SeTakeOwnershipPrivilege, kills sql/veeam/backup processes, can print the ransom note"
  ],
  "insufficientReporting": false,
