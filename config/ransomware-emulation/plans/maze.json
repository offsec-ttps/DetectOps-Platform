{
  "gang": "maze",
  "displayName": "Maze",
  "aliases": [
    "ChaCha ransomware",
    "TWISTED SPIDER (operator)"
  ],
  "status": "defunct",
  "activeSince": "2019",
  "lineage": "Announced shutdown Nov 2020; Egregor is widely regarded as its successor; Maze pioneered the data-leak-site extortion model later adopted by nearly all RaaS",
  "summary": "Maze appeared in May 2019 via spam and exploit kits and shifted to post-compromise, affiliate-driven deployment by late 2019, being the first major group to run a public leak site. Mandiant observed access via RDP/Citrix with valid credentials and malspam, Cobalt Strike BEACON, AdFind/BloodHound discovery, ProcDump/Mimikatz credential theft, archiving with 7-Zip/WinRAR and FTP/WinSCP exfiltration, then PsExec deployment. In 2020 affiliates adopted Ragnar Locker's trick of running the encryptor inside a VirtualBox VM.",
  "uniqueTraits": [
    "First large-scale name-and-shame data leak site (Nov 2019)",
    "Exfiltration of archived data over FTP/WinSCP to actor servers",
    "Encryptor launched inside a Windows 7 VirtualBox VM to evade host security (Sep 2020)",
    "Batch-script propagation of the payload across hosts"
  ],
  "insufficientReporting": false,
