{
  "gang": "netwalker",
  "displayName": "NetWalker",
  "aliases": [
    "Mailto",
    "Koko"
  ],
  "status": "disrupted",
  "activeSince": "2019",
  "lineage": "Originally named Mailto; disrupted by a coordinated US/Bulgarian law-enforcement action in January 2021 (leak site seized, affiliate arrested)",
  "summary": "NetWalker (formerly Mailto) was a RaaS that surged in 2020, targeting healthcare, education and government. Early waves used COVID-themed phishing with VBS loaders; from April 2020 affiliates exploited VPN appliances (Pulse Secure CVE-2019-11510) and web UI components (Telerik CVE-2019-18935), or weak RDP passwords. The payload was often delivered filelessly by a PowerShell script that reflectively injected the DLL into explorer.exe. Sophos and The DFIR Report document SoftPerfect netscan, Mimikatz variants, ProcDump, TeamViewer/AnyDesk and PsExec-based mass deployment.",
  "uniqueTraits": [
    "Fileless delivery: PowerShell loader reflectively injects the NetWalker DLL into explorer.exe",
    "Exploited Telerik UI CVE-2019-18935 and Pulse Secure CVE-2019-11510",
    "Toolkit with Mimidogz/Mimikittenz Mimikatz variants and privilege-escalation exploits (CVE-2015-1701, CVE-2018-8453)",
    "Encryption of all domain systems within ~1 hour via PsExec"
  ],
  "insufficientReporting": false,
