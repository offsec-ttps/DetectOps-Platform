{
  "gang": "Rhysida",
  "displayName": "Rhysida",
  "aliases": [
    "Vanilla Tempest (Microsoft, partial overlap)",
    "Vice Society successor"
  ],
  "status": "active",
  "activeSince": "2023",
  "lineage": "Overlaps with Vice Society (DEV-0832 / Vanilla Tempest)",
  "summary": "Rhysida is a RaaS/double-extortion operation first seen in May 2023 that hits targets of opportunity in education, healthcare, manufacturing and government. Historically it entered through VPNs with stolen credentials (no MFA), Zerologon and phishing; since 2024-2025 it relies heavily on Bing/Google malvertising for fake Microsoft Teams, PuTTY and Zoom installers that deliver the code-signed OysterLoader/Broomstick backdoor. Post-compromise tradecraft is LOTL with heavy PsExec use, NTDS theft and staged batch-script deployment of a MinGW-compiled ChaCha20/RSA encryptor.",
  "uniqueTraits": [
    "Malvertising of fake MSTeamsSetup.exe / PuTTY / Zoom installers delivering OysterLoader (Broomstick/CleanUpLoader)",
    "Abuse of dozens of fraudulently obtained code-signing certificates (47 tracked by Expel; Microsoft revoked 200+)",
    "Staging directories C:\\in and C:\\out with S_0.bat/S_1.bat/S_2.bat and an encryptor named conhost.exe pushed by PsExec",
    "PuTTY SSH lateral movement and PortStarter Go backdoor (Vice Society heritage)"
  ],
  "insufficientReporting": false,
