{
  "gang": "Royal",
  "displayName": "Royal / BlackSuit",
  "aliases": [
    "BlackSuit",
    "Zeon",
    "DEV-0569 (access cluster)"
  ],
  "status": "rebranded",
  "activeSince": "2022",
  "lineage": "Conti 'Team One' -> Zeon -> Royal (2022) -> BlackSuit (2023); BlackSuit infrastructure seized in Operation Checkmate (Jul 2025); Chaos RaaS assessed as likely successor",
  "summary": "Royal, run by ex-Conti operators, favoured callback phishing (fake subscription invoices directing victims to install remote tools) and malvertising/BatLoader installers, alongside RDP and public-facing exploits. Operators then use RMM tools, Chisel tunnels, SoftPerfect NetScan, NirSoft/Mimikatz, PCHunter/PowerTool/GMER to kill AV, PsExec/RDP, and Cobalt Strike/Ursnif/rclone for exfiltration, before partial encryption of Windows and ESXi. The group rebranded to BlackSuit in 2023.",
  "uniqueTraits": [
    "Callback phishing (TOAD) inherited from Conti BazarCall",
    "Malvertising and signed MSI/BatLoader installers via DEV-0569",
    "Configurable partial encryption (-ep percentage) and network-only (-id) modes",
    "Ursnif/Gozi repurposed for data aggregation and exfiltration",
    "ESXi variant terminating VMs via esxcli"
  ],
  "insufficientReporting": false,
