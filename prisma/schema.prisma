// ─── Detection Pack Pipeline (Phase 1) ─────────────────────────────────────
// Each pack is one "actionable detection" derived from a TI report or a
// community rule. Rules are stored per-format in DetectionRule rows; the IR
// playbook lives in IrPlaybook (1:1 with the pack).

model DetectionPack {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  description       String   @default("")
  severity          String   @default("medium")        // info|low|medium|high|critical
  riskScore         Int      @default(50)              // 0..100
  category          String   @default("other")         // web|network|os-windows|os-linux|os-macos|cloud|identity|email|third-party|other
  platforms         String   @default("[]")            // JSON: ["windows","linux",...]
  dataSources       String   @default("[]")            // JSON: ["Sysmon","CloudTrail",...]
  mitreTechniques   String   @default("[]")
  mitreTactics      String   @default("[]")
  references        String   @default("[]")            // JSON: [{title,url,type:"report"|"blog"|"advisory"|"community"}]
  status            String   @default("draft")         // draft|test|tune|validate|production|deprecated
  sourceType        String                              // "ti" | "rule"
  sourceTable       String                              // ThreatIntelReport | CommunityRule | CommunitySigmaRule | …
  sourceRefId       String
  generatorRunId    String?                             // FK into AiGeneration for the primary run
  githubIssueUrl    String?
  githubIssueNumber Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  rules             DetectionRule[]
  irPlaybook        IrPlaybook?
  simulations       DetectionSimulation[]
  @@index([category])
  @@index([severity, riskScore])
  @@index([sourceType, sourceRefId])
  @@map("detection_packs")
}

model DetectionRule {
  id               String   @id @default(uuid())
  packId           String
  pack             DetectionPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  format           String                              // sigma|spl|kql|elastic-eql|elastic-lucene|yara|falco|wazuh
  title            String
  body             String                              // full rule text
  language         String   @default("")               // sigma|kuery|lucene|eql|spl|yara-l|… (refines format)
  validationStatus String   @default("unvalidated")    // unvalidated|valid|invalid|converted
  validationNotes  String   @default("")
  falsePositives   String   @default("[]")             // JSON array of strings
  createdAt        DateTime @default(now())
  @@index([packId, format])
  @@map("detection_rules")
}

model DetectionSimulation {
  id          String   @id @default(uuid())
  packId      String
  pack        DetectionPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  framework   String                                   // atomic|purplesharp|stratus
  refId       String   @default("")                    // AtomicTest.testGuid / PSVariation.id / StratusAttack.attackId
  techniqueId String
  displayName String
  description String   @default("")
  rationale   String   @default("")                    // why this sim validates the rule
  createdAt   DateTime @default(now())
  @@index([packId])
  @@map("detection_simulations")
}

model IrPlaybook {
  id          String   @id @default(uuid())
  packId      String   @unique
  pack        DetectionPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  summary     String   @default("")
  // Structured steps per tier — JSON array of:
  //   { order:int, title:string, action:string, expectedFinding:string,
  //     escalateIf:string, references:string[] }
  l1Steps     String   @default("[]")
  l2Steps     String   @default("[]")
  l3Steps     String   @default("[]")
  containment String   @default("[]")
  eradication String   @default("[]")
  recovery    String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("ir_playbooks")
}

// Job queue stub — populated by Phase 3's post-sync hooks. Added in Phase 1
// so the worker can land without a follow-up migration.
model DetectionPackJob {
  id              String    @id @default(uuid())
  sourceType      String                                // "ti"|"rule"
  sourceTable     String
  sourceRefId     String
  status          String    @default("queued")         // queued|running|completed|failed|skipped|budget-exceeded
  attempts        Int       @default(0)
  costEstimateUsd Float     @default(0)
  packId          String?
  errorMessage    String?
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  @@unique([sourceTable, sourceRefId])
  @@index([status, createdAt])
  @@map("detection_pack_jobs")
}

// ─── Enterprise Use Case Pipeline (Phase 1) ─────────────────────────────────
// Org-uploaded detection use cases with full lifecycle: upload (any format) →
// validate → map → simulate → coverage check → report → promote. Five models
// are added up-front so later phases don't require fresh migrations.

model EnterpriseUseCase {
  id                        String   @id @default(uuid())
  name                      String
  description               String   @default("")
  // Detection logic — three columns + chooser
  originalDetectionLogic    String   @default("")
  recommendedDetectionLogic String   @default("")           // canonical Sigma synth
  recommendedSpl            String   @default("")           // Sigma → SPL via sigma-cli or community import
  recommendedKql            String   @default("")           // Sigma → KQL via sigma-cli or community import
  recommendedNotes          String   @default("[]")         // JSON: per-format conversion notes
  editedDetectionLogic      String   @default("")           // user edit of the Sigma
  editedSpl                 String   @default("")           // user edit of the SPL body
  editedKql                 String   @default("")           // user edit of the KQL body
  selectedLogic             String   @default("original")   // original | recommended | edited
  selectedFormat            String   @default("sigma")      // sigma | spl | kql — which body the user picked
  format                    String   @default("")           // sigma | spl | kql | elastic-toml | yara | freeform
  severity                  String   @default("medium")     // info | low | medium | high | critical
  platforms                 String   @default("[]")
  dataSources               String   @default("[]")
  owner                     String   @default("")
  // Provenance
  uploadBatchId             String?
  sourceFilename            String?
  sourceRowRef              String   @default("")
  uploadedBy                String   @default("")
  // Lifecycle
  status                    String   @default("imported")   // imported | mapped | scenarios-defined | validated | promoted | retired
  validationStatus          String   @default("pending")    // pending | green | yellow | red
  validationDetails         String   @default("{}")         // JSON: per-check results
  lastValidatedAt           DateTime?
  nextValidationDueAt       DateTime?
  validationCadenceDays     Int      @default(365)
  // SIEM compat for the selected logic — JSON object: { splunk:"ok|warn|fail", sentinel:..., esql:... }
  siemCompatibility         String   @default("{}")
  // MITRE
  mitreTechniques           String   @default("[]")
  mitreTactics              String   @default("[]")
  // GitHub link (Phase 4)
  githubIssueUrl            String?
  githubIssueNumber         Int?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  scenarios                 EnterpriseUseCaseScenario[]
  runs                      EnterpriseUseCaseRun[]
  comments                  EnterpriseUseCaseComment[]
  @@index([status])
  @@index([validationStatus])
  @@index([owner])
  @@index([uploadBatchId])
  @@map("enterprise_use_cases")
}

model EnterpriseUploadBatch {
  id              String   @id @default(uuid())
  filename        String
  format          String                                     // xlsx | csv | md | txt | sigma | spl | kql | yaml | toml | yara
  bytes           Int      @default(0)
  parsedRowCount  Int      @default(0)
  createdRowCount Int      @default(0)
  status          String   @default("parsing")              // parsing | preview | committed | failed
  parseErrors     String   @default("[]")
  previewJson     String   @default("[]")                   // JSON: parsed-but-not-committed rows (Phase 1 keeps the full preview here so commit can re-use it)
  uploadedBy      String   @default("")
  createdAt       DateTime @default(now())
  @@map("enterprise_upload_batches")
}

model EnterpriseUseCaseScenario {
  id          String   @id @default(uuid())
  useCaseId   String
  useCase     EnterpriseUseCase @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  ordinal     Int
  name        String
  description String   @default("")
  steps       String   @default("[]")
  source      String   @default("auto")                     // auto | manual-edit | mixed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([useCaseId, ordinal])
  @@index([useCaseId])
  @@map("enterprise_use_case_scenarios")
}

model EnvironmentTarget {
  id                   String   @id @default(uuid())
  name                 String   @unique
  kind                 String                                // our-template-deployed | user-cloud | agent | shell
  templateRef          String   @default("")                // splunk-attack-range | goad
  cloudProvider        String   @default("")                // aws | azure | gcp
  shellMode            String   @default("")                // reverse | bind
  description          String   @default("")
  hostname             String   @default("")
  port                 Int      @default(0)
  region               String   @default("")
  credentialId         String?
  sshUser              String   @default("")
  sshKeyRef            String   @default("")
  agentEnrollmentToken String   @default("")                // AES-GCM via vault key (encrypted at rest)
  listenerHost         String   @default("")
  listenerPort         Int      @default(0)
  payloadKind          String   @default("")                // script | binary | inline
  payloadRef           String   @default("")
  goadInstanceId       String?
  splunkAttackRangeRef String?
  // ── Agent backend (Phase: Adversary Simulation) ──
  // When kind="agent", which backend executes: a user-run Caldera server, or
  // our native lightweight BAS fleet (Rust agent + NATS).
  agentBackend         String   @default("caldera")         // caldera | native-fleet
  calderaUrl           String   @default("")
  calderaApiKeyEnc     String   @default("")                // AES-GCM via vault key
  calderaGroup         String   @default("red")
  calderaPaw           String   @default("")                // resolved Caldera agent id
  agentPlatform        String   @default("")                // windows | linux | darwin
  fleetId              String?                              // when agentBackend="native-fleet" → Fleet.id
  ownerId              String   @default("")                // AuthUser.id of the creator (multi-tenant scoping)
  enabled              Boolean  @default(true)
  lastSeenAt           DateTime?
  lastError            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  @@index([kind])
  @@index([enabled])
  @@index([ownerId])
  @@map("environment_targets")
}

model EnterpriseUseCaseRun {
  id                String   @id @default(uuid())
  useCaseId         String
  useCase           EnterpriseUseCase @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  scenarioId        String?
  environmentId     String?
  testedLogicChoice String   @default("")                   // original | recommended | edited
  mode              String                                   // simulate-only | simulate-and-validate
  runMode           String   @default("immediate")          // immediate | draft | scheduled
  scheduledFor      DateTime?                                // when this run should fire (null = fire now)
  status            String   @default("queued")             // queued | running | success | failure | timeout | draft | scheduled | cancelled
  preflight         String   @default("[]")                  // JSON: per-check results captured at run start
  startedAt         DateTime?
  completedAt       DateTime?
  durationMs        Int      @default(0)
  exitCode          Int?
  stepResults       String   @default("[]")
  logs              String   @default("")
  detectionResults  String   @default("[]")
  validationOutcome String   @default("")                   // matched | partial | missed | error | n/a
  actor             String   @default("")
  createdAt         DateTime @default(now())
  @@index([useCaseId, createdAt])
  @@index([status])
  @@index([validationOutcome])
  @@index([scheduledFor])
  @@map("enterprise_use_case_runs")
}

model EnterpriseUseCaseComment {
  id          String   @id @default(uuid())
  useCaseId   String
  useCase     EnterpriseUseCase @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  runId       String?
  author      String   @default("")
  body        String
  kind        String   @default("note")                     // note | review | tuning | hand-off | escalation
  createdAt   DateTime @default(now())
  @@index([useCaseId, createdAt])
  @@index([runId])
  @@map("enterprise_use_case_comments")
}

// ─── LLM Provider Management (Phase 6) ──────────────────────────────────────
// User-managed LLM provider configs. Lets operators add an API key for each
// supported vendor, switch the active model, define custom OpenAI-compatible
// endpoints, and verify connectivity from the UI. Keys are AES-GCM encrypted
// at rest via the existing CREDENTIAL_VAULT_KEY.

model LlmProviderConfig {
  id              String   @id @default(uuid())
  label           String                                      // human label shown in the UI
  kind            String                                      // anthropic | openai | openrouter | nvidia | ollama | openai-compatible | custom
  // Connectivity
  baseUrl         String   @default("")                       // empty → provider's default endpoint
  apiKeyEnc       String   @default("")                       // AES-GCM via vault key; "" when none required (e.g. ollama)
  // Model selection
  defaultModel    String   @default("")                       // model id the dispatcher uses when no model is specified
  // Custom auth header style — only honoured for kind="custom"
  authHeaderName  String   @default("Authorization")          // e.g. "X-API-Key" for vendors who don't use Bearer
  authHeaderValue String   @default("Bearer {{key}}")         // template — {{key}} substituted at runtime
  // Optional: when set, listModels uses this verbatim path (relative to baseUrl)
  modelsPath      String   @default("")                       // e.g. "/v1/models"
  // State
  enabled         Boolean  @default(true)
  isDefault       Boolean  @default(false)                    // exactly one row should carry this; dispatcher uses it as fallback
  // Test state
  lastTestedAt    DateTime?
  lastTestOk      Boolean  @default(false)
  lastTestLatency Int      @default(0)
  lastTestMessage String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([kind])
  @@index([enabled, isDefault])
  @@map("llm_provider_configs")
}

// Outbound MCP servers this app queries for enrichment data (distinct from
// McpApiKey, which is inbound auth for the app's own MCP server).
model McpClientServer {
  id              String    @id @default(uuid())
  label           String                                        // human label shown in the UI; also the registry entry name
  transport       String                                        // "stdio" | "http"
  address         String                                        // command line (stdio) or URL (http)
  tokenEnc        String    @default("")                        // AES-GCM via vault key; sent as Authorization: Bearer <token> for http
  enabled         Boolean   @default(true)
  // Test state
  lastTestedAt    DateTime?
  lastTestOk      Boolean   @default(false)
  lastTestLatency Int       @default(0)
  lastTestMessage String    @default("")
  lastToolCount   Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([enabled])
  @@map("mcp_client_servers")
}

// ─── SigmaGen AI (multi-agent threat-intel → detection pipeline) ─────────────
// A ChatGPT-style session where a user drops a URL / PDF / docx / txt / IOC /
// free text. A multi-agent pipeline (intel-extract → ATT&CK-map → use-case →
// detection → simulation → validation) ingests it, pulls related intel, and
// produces three artifacts: use cases, simulations, and detection rules.
//
// Heavy artifacts REUSE existing tables: detection rules/sims/IRP land in
// DetectionPack (sourceTable="SigmaGenRun"); use cases land in UseCase
// (sourceRefType="SigmaGenRun"); every LLM call logs an AiGeneration row with a
// "sigmagen:" generator prefix. These three tables own only the chat/run state.

model SigmaGenSession {
  id        String            @id @default(uuid())
  title     String            @default("Untitled session")
  createdBy String            @default("")
  status    String            @default("active")          // active | archived
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  messages  SigmaGenMessage[]
  runs      SigmaGenRun[]
  @@index([createdBy, updatedAt])
  @@map("sigmagen_sessions")
}

model SigmaGenMessage {
  id             String          @id @default(uuid())
  sessionId      String
  session        SigmaGenSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role           String                                    // user | assistant | system
  content        String          @default("")
  inputKind      String          @default("")             // url | pdf | docx | txt | ioc | text
  attachmentName String          @default("")
  runId          String?                                   // assistant messages link to the run that produced artifacts
  createdAt      DateTime        @default(now())
  @@index([sessionId, createdAt])
  @@map("sigmagen_messages")
}

model SigmaGenRun {
  id             String          @id @default(uuid())
  sessionId      String
  session        SigmaGenSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status         String          @default("queued")        // queued | running | completed | failed | budget-exceeded
  inputKind      String          @default("text")          // url | pdf | docx | txt | ioc | text
  inputTitle     String          @default("")
  // Pipeline state
  steps          String          @default("[]")            // JSON [{agent,status,startedAt,completedAt,summary}]
  normalizedText String          @default("")              // ingested + retrieved digest (truncated) — fed to loadSource
  techniques     String          @default("[]")            // JSON ["T1059.001",...] mapped technique list
  references     String          @default("[]")            // JSON [{title,url,type}] incl. retrieved citations
  intelJson      String          @default("{}")            // JSON: structured intel-extract output for UI display
  useCasesJson   String          @default("[]")            // JSON: enriched use cases (objective, scenario, logSources, validation, expectedAlerts, sims) for display
  guardrailJson  String          @default("{}")            // JSON: guardrail report (injection/jailbreak scan + sanitisation) for this run's input
  // Produced artifacts (FKs to reused tables)
  detectionPackId String?                                  // → DetectionPack.id
  useCaseIds     String          @default("[]")            // JSON array of UseCase.id
  // Bookkeeping
  attempts       Int             @default(0)
  costUsd        Float           @default(0)
  inputTokens    Int             @default(0)
  outputTokens   Int             @default(0)
  errorMessage   String?
  createdAt      DateTime        @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  @@index([sessionId, createdAt])
  @@index([status, createdAt])
  @@map("sigmagen_runs")
}

// ─── Native BAS Fleet (Adversary Simulation — Track 2) ──────────────────────
// A first-party lightweight endpoint-simulation fleet: Rust agents enroll, beacon
// liveness, and execute version-pinned Atomic Red Team tests locally, reporting
// execution + detection telemetry back. Defensive BAS: every operation is
// consent-gated; agents run ONLY curated, hash-pinned bundles (no raw-command exec).

model Fleet {
  id                String   @id @default(uuid())
  name              String
  ownerId           String   @default("")        // AuthUser.id of the creator (multi-tenant scoping)
  customerId        String   @default("")
  allowedScope      String   @default("[]")     // JSON: test-pack ids this fleet may EVER run
  consentId         String?                      // signed authorization (required to run)
  natsSubjectPrefix String   @default("")        // bas.* scoping (M3+)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([ownerId])
  @@map("fleets")
}

model FleetNode {
  id            String    @id @default(uuid())   // node-id
  fleetId       String
  name          String    @default("")
  hostname      String    @default("")
  os            String    @default("")           // windows | linux | darwin
  osVersion     String    @default("")
  arch          String    @default("")
  agentVersion  String    @default("")
  apiKeyEnc     String    @default("")           // per-node HTTP secret (AES-GCM)
  status        String    @default("offline")    // offline | online | revoked
  enrolledScope String    @default("[]")
  lastSeen      DateTime?
  hostStatus    String    @default("{}")         // cpu/ram/edr facts JSON
  currentRunId  String?
  createdAt     DateTime  @default(now())
  @@index([fleetId, status])
  @@map("fleet_nodes")
}

model EnrollmentToken {
  id           String   @id @default(uuid())
  fleetId      String
  tokenHash    String   @unique                  // sha256 of the token; plaintext shown once
  label        String   @default("")
  allowedScope String   @default("[]")
  expiresAt    DateTime
  usedCount    Int      @default(0)
  maxUses      Int      @default(0)              // 0 = unlimited within TTL
  revoked      Boolean  @default(false)
  createdBy    String   @default("")
  createdAt    DateTime @default(now())
  @@index([fleetId])
  @@map("enrollment_tokens")
}

model FleetCampaign {
  id            String   @id @default(uuid())
  fleetId       String
  createdBy     String   @default("")
  testSelection String   @default("[]")          // [{technique,testIndex,bundleHash}]
  targetNodeIds String   @default("[]")
  schedule      String   @default("{}")          // {type:now|cron|at, expr, window}
  execution     String   @default("{}")          // {mode, interTestDelayMs, stopOnBlock, requireCleanup:true}
  consentId     String?
  status        String   @default("created")     // created|populating|running|completed|failed|halted
  opsExpected   Int      @default(0)
  runId         String?                           // optional link to EnterpriseUseCaseRun
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([fleetId, status])
  @@map("fleet_campaigns")
}

model FleetOperation {
  id         String   @id @default(uuid())
  campaignId String
  nodeId     String
  data       String   @default("{}")             // {technique,testIndex,bundleHash,inputArgs,executor,elevation,cleanup,maxRuntimeMs}
  status     String   @default("queued")         // queued|running|success|failed|blocked|cleanup_failed
  claimedBy  String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([campaignId, status])
  @@index([nodeId, status])
  @@map("fleet_operations")
}

model FleetTestRun {
  id            String    @id @default(uuid())
  operationId   String
  nodeId        String
  technique     String
  testIndex     Int       @default(0)
  bundleHash    String    @default("")
  exitCode      Int?
  executeStatus String    @default("")           // success|failed|blocked
  cleanupStatus String    @default("")           // ok|failed
  detection     String    @default("{}")         // {verdict:detected|missed|blocked, edrEventsRef, score}
  stdoutRef     String    @default("")           // execute stdout (preview; blobs → object store in M6)
  stderrRef     String    @default("")           // execute stderr
  cleanupStdoutRef String @default("")           // cleanup stdout
  cleanupStderrRef String @default("")           // cleanup stderr
  durationMs    Int       @default(0)
  telemetryRef  String    @default("")
  startedAt     DateTime?
  endedAt       DateTime?
  @@index([operationId])
  @@index([nodeId])
  @@map("fleet_test_runs")
}

model Consent {
  id           String    @id @default(uuid())
  customerId   String    @default("")
  scope        String    @default("{}")
  authorizedBy String    @default("")
  signedDocRef String    @default("")
  validFrom    DateTime?
  validTo      DateTime?
  createdAt    DateTime  @default(now())
  @@map("consents")
}

// ── C2 server for Fleet Simulation (user-selectable adversary-emulation C2) ──
// A standalone C2 controller (MITRE Caldera first; Sliver/OpenBAS later),
// DECOUPLED from the Local-Lab Caldera. Endpoints run a lightweight C2 beacon
// and the server pushes TTPs over the channel — no per-endpoint tooling install.
// A C2Server can be "connect"ed (bring-your-own URL+key) or "managed" (deployed
// by us as a Docker container). On health-OK it auto-registers a backing
// EnvironmentTarget(kind=agent, agentBackend=caldera) so the existing runner +
// Campaign Designer execute against it unchanged.
model C2Server {
  id                  String    @id @default(uuid())
  ownerId             String    @default("")           // AuthUser.id (multi-tenant scoping)
  name                String    @unique
  provider            String    @default("caldera")    // caldera | sliver | openbas
  mode                String    @default("connect")    // connect (BYO) | managed (platform-deployed)
  url                 String    @default("")           // base URL beacons + REST API use, e.g. http://<lan-ip>:8888
  apiKeyEnc           String    @default("")           // AES-GCM via vault key
  group               String    @default("red")        // Caldera group / agent bucket
  advertiseHost       String    @default("")           // LAN IP advertised to beacons (managed deploy)
  agentPlatform       String    @default("")           // windows | linux | darwin (optional ability filter)
  deploymentId        String?                          // managed → labs/deployments/<id>
  environmentTargetId String?                          // the auto-registered EnvironmentTarget it feeds
  adminUser           String    @default("")           // managed Caldera UI login (local lab cred)
  adminPassword       String    @default("")           // managed Caldera UI login (local lab cred, plaintext like Integration creds)
  // connect mode:  online | offline | error | unknown
  // managed mode:  installing | installed | starting | running | stopped | error
  status              String    @default("unknown")
  lastError           String    @default("")
  lastSeen            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  @@index([ownerId])
  @@index([provider])
  @@map("c2_servers")
}

// ── SIEM connection for Simulation & Detection (bring-your-own, per-environment) ──
// Each simulation environment (Local Lab / Cloud Lab / Fleet / C2) can validate
// detection against its OWN SIEM. Splunk (SPL) and Microsoft Defender for
// Endpoint (MDE, KQL via Graph Advanced Hunting) are supported. Secrets are
// AES-GCM encrypted (credential-vault), never stored plaintext — unlike the
// legacy Integration table. Resolved per target at validation time.
model SiemConnection {
  id            String    @id @default(uuid())
  ownerId       String    @default("")            // AuthUser.id (multi-tenant scoping)
  name          String    @unique
  kind          String    @default("splunk")      // splunk | mde
  scope         String    @default("any")          // local | cloud | fleet | c2 | any — which env it serves
  targetRef     String    @default("")             // optional: env name / fleetId / c2Id it's bound to
  isDefault     Boolean   @default(false)          // default connection for its scope
  // Non-secret config
  url           String    @default("")             // Splunk REST base, e.g. https://host:8089
  authMode      String    @default("token")        // splunk: token | basic ; mde: oauth
  tenantId      String    @default("")             // MDE: Azure AD tenant id
  clientId      String    @default("")             // MDE: app registration client id
  username      String    @default("")             // Splunk basic-auth user (non-secret)
  // Secrets (AES-GCM JSON of { token? | password? | clientSecret? })
  secretsEnc    String    @default("")
  status        String    @default("unknown")      // unknown | online | error
  lastError     String    @default("")
  lastTested    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@index([ownerId])
  @@index([kind])
  @@index([scope])
  @@map("siem_connections")
}

// ── Simulation Module marketplace (plugin architecture) ──
// A module is DECLARATIVE content (manifest + scenarios + UI metadata) that
// compiles to ScenarioStep[] the existing runner executes. No arbitrary code.
model SimulationModule {
  id             String    @id @default(uuid())
  moduleId       String    @unique                  // publisher.name
  name           String
  version        String                             // current live semver
  category       String    @default("")             // ransomware|phishing|lateral-movement|...
  description    String    @default("")
  author         String    @default("")
  icon           String    @default("")
  manifest       String    @default("{}")           // full module.json JSON
  contentHash    String    @default("")             // sha256 of canonical package
  status         String    @default("submitted")    // submitted|validating|approved|live|rejected|disabled
  signatureState String    @default("unsigned")     // unsigned|signed|verified|invalid
  signatureB64   String    @default("")
  permissions    String    @default("{}")           // declared capabilities JSON (enforced at runtime)
  packageRef     String    @default("")             // sha256-keyed package store ref
  ownerId        String    @default("")             // AuthUser.id
  enabled        Boolean   @default(true)
  installedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  versions       ModuleVersion[]
  validations    ModuleValidationRun[]
  @@index([status])
  @@index([category])
  @@index([ownerId])
  @@map("simulation_modules")
}

model ModuleVersion {
  id           String   @id @default(uuid())
  moduleRowId  String                               // FK SimulationModule.id
  module       SimulationModule @relation(fields: [moduleRowId], references: [id], onDelete: Cascade)
  version      String
  manifest     String   @default("{}")
  contentHash  String   @default("")
  packageRef   String   @default("")
  signatureB64 String   @default("")
  changelog    String   @default("")
  status       String   @default("draft")           // draft|published|yanked
  createdAt    DateTime @default(now())
  @@unique([moduleRowId, version])
  @@index([moduleRowId])
  @@map("module_versions")
}

model ModuleValidationRun {
  id              String    @id @default(uuid())
  moduleRowId     String                            // FK SimulationModule.id
  module          SimulationModule @relation(fields: [moduleRowId], references: [id], onDelete: Cascade)
  version         String
  status          String    @default("queued")      // queued|running|passed|failed|budget-exceeded
  attempts        Int       @default(0)
  checks          String    @default("[]")          // JSON [{name,status,detail}]
  aiReview        String    @default("{}")           // JSON: runTool verdict + rationale
  dryRunResults   String    @default("[]")          // JSON: StepRunResult[] from dry-run
  verdict         String    @default("")            // auto-approve|needs-human|reject
  costEstimateUsd Float     @default(0)
  errorMessage    String?
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  @@unique([moduleRowId, version])
  @@index([status, createdAt])
  @@map("module_validation_runs")
}

// ── Self-hosted ransomware-gang intelligence (RansomLook-style) ──
model RansomwareGang {
  id             String    @id @default(uuid())
  name           String    @unique
  aliases        String    @default("[]")            // JSON string[]
  status         String    @default("active")        // active|inactive|rebranded|unknown
  tier           String    @default("")
  leakSiteUrls   String    @default("[]")            // JSON string[]
  screenshotRef  String    @default("")              // screenshot store ref / URL
  description    String    @default("")
  profile        String    @default("{}")            // JSON (raw collector profile)
  knownTTPs      String    @default("[]")            // JSON [{id,name,tactic}]
  iocs           String    @default("{}")            // JSON {network[],file[],behavioral[]}
  signatures     String    @default("[]")            // JSON [{kind,name,ref}]
  targetSectors  String    @default("[]")            // JSON string[]
  targetRegions  String    @default("[]")            // JSON string[]
  victimCount    Int       @default(0)
  references     String    @default("[]")            // JSON [{title,url}]
  source         String    @default("seed")          // seed|collector|ai
  enrichedAt     DateTime?
  contentHash    String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@index([status])
  @@index([source])
  @@map("ransomware_gangs")
}

model RansomwareVictim {
  id            String    @id @default(uuid())
  gangName      String
  victim        String
  sector        String    @default("")
  country       String    @default("")
  postUrl       String    @default("")
  screenshotRef String    @default("")
  discoveredAt  DateTime?
  contentHash   String    @default("")
  createdAt     DateTime  @default(now())
  @@unique([gangName, victim, discoveredAt])
  @@index([gangName])
  @@index([discoveredAt])
  @@map("ransomware_victims")
}

model IntelApiKey {
  id             String    @id @default(uuid())
  label          String    @default("")
  keyHash        String    @unique                   // sha256 of the raw key
  prefix         String    @default("")              // shown in UI to identify the key
  ownerId        String    @default("")
  scopes         String    @default("[]")            // JSON string[] (e.g. ["read"])
  rateLimitPerMin Int      @default(120)
  enabled        Boolean   @default(true)
  requestCount   Int       @default(0)
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?
  @@index([enabled])
  @@map("intel_api_keys")
}

// Issued API keys for the public detection-content MCP server.
//   - mintKey() returns the plaintext key ONCE (dmcp_<prefix>_<secret>); only
//     sha256(key) + a short prefix are stored.
//   - requireMcpApiKey() authenticates, enforces per-minute rate limit + a durable
//     daily quota, checks scopes, and bumps usage counters.
model McpApiKey {
  id              String    @id @default(uuid())
  label           String    @default("")
  keyHash         String    @unique                   // sha256 of the raw key
  prefix          String    @default("")              // shown in UI to identify the key
  ownerId         String    @default("")
  scopes          String    @default("[]")            // JSON string[] e.g. ["detections:read","intel:read"]
  tier            String    @default("free")          // free | pro | admin
  rateLimitPerMin Int       @default(60)
  dailyQuota      Int       @default(200)
  requestCount    Int       @default(0)               // cumulative lifetime calls
  dailyCount      Int       @default(0)               // calls in the current daily window
  dailyResetAt    DateTime?                           // when dailyCount was last reset
  enabled         Boolean   @default(true)
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?
  @@index([enabled])
  @@map("mcp_api_keys")
}

model IntelCollectionRun {
  id            String    @id @default(uuid())
  collector     String                                // ransomwatch|ransomware-live|tor-leaksite|all
  status        String    @default("running")         // running|success|failed
  groupsNew     Int       @default(0)
  groupsUpdated Int       @default(0)
  victimsNew    Int       @default(0)
  errors        String    @default("[]")              // JSON string[]
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  @@index([status, startedAt])
  @@map("intel_collection_runs")
}

// ── Multi-mode phishing simulation (authorized, audited, consent-gated) ──
model PhishingCampaign {
  id            String    @id @default(uuid())
  name          String
  mode          String    @default("template")        // template | tool | ai
  status        String    @default("draft")           // draft|pending_approval|approved|running|completed|aborted|rejected
  config        String    @default("{}")              // JSON: {templateId|toolId|aiPrompt, targetPersona, scenario, techniques[], consent}
  generated     String    @default("{}")              // JSON: AI/template content {subject, body, landing}
  techniques    String    @default("[]")              // JSON string[] (ATT&CK ids exercised)
  approval      String    @default("{}")              // JSON: {requestedBy, approvedBy, approvedAt, note, decision}
  results       String    @default("{}")              // JSON: detection-run summary
  runId         String    @default("")                // EnterpriseUseCaseRun id from the simulation
  ownerId       String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  launchedAt    DateTime?
  completedAt   DateTime?
  @@index([status])
  @@index([ownerId])
  @@map("phishing_campaigns")
}

model PhishingTemplate {
  id            String    @id @default(uuid())
  name          String    @unique
  category      String    @default("")                // credential-harvest|attachment|link|bec|mfa-fatigue
  kind          String    @default("email")           // email | landing
  subject       String    @default("")
  body          String    @default("")                // HTML/text with {placeholders}
  placeholders  String    @default("[]")              // JSON string[]
  techniques    String    @default("[]")              // JSON string[] ATT&CK ids
  sourceRef     String    @default("")                // attribution
  license       String    @default("")
  createdAt     DateTime  @default(now())
  @@index([category])
  @@map("phishing_templates")
}
