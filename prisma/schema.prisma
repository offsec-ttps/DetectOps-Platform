generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model CommunitySource {
  id                 String   @id @default(uuid())
  name               String   @unique
  type               String
  description        String   @default("")
  url                String   @default("")
  lastSyncAt         DateTime?
  totalRules         Int      @default(0)
  importedRulesCount Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  rules CommunitySigmaRule[]
  elasticRules CommunityElasticRule[]
  // Phase 1 expansion: any source registered through the new adapter interface
  // (MITRE CAR, Sentinel, Defender XDR, Google SecOps, Panther, Falco, Wazuh)
  // writes its rules into the unified CommunityRule table.
  unifiedRules CommunityRule[]

  @@map("community_sources")
}

// ── Unified Community Rule Model (Phase 1 — Community Content Expansion) ──
//
// Normalized container for any NEW community detection source registered via
// the source adapter interface. Existing SigmaHQ / Elastic / Splunk syncs
// keep using their dedicated tables (CommunitySigmaRule / CommunityElasticRule
// / SplunkDetection). This is purely additive.
//
// One row per detection rule from any new source. The original raw payload
// is preserved in `rawPayload` so source-specific rendering can still drill
// down into format-native fields.
model CommunityRule {
  id                  String   @id @default(uuid())
  sourceId            String

  // ── Identity ──
  upstreamRuleId      String?  // source-native id (CAR analytic id, KQL guid, YARA-L name, etc)
  title               String
  description         String   @default("")
  author              String   @default("")
  upstreamCreatedAt   DateTime?
  upstreamModifiedAt  DateTime?

  // ── ATT&CK alignment ──
  mitreTechniques     String   @default("[]")  // JSON array of TXXXX[.XXX]
  mitreTactics        String   @default("[]")  // JSON array

  // ── Targeting ──
  platforms           String   @default("[]")  // JSON: windows|linux|macos|cloud|network|container...
  products            String   @default("[]")  // JSON: e.g. "splunk", "kql", "carbonblack"
  logSources          String   @default("[]")  // JSON: free-form source identifiers
  tags                String   @default("[]")  // JSON

  // ── Content ──
  ruleLanguage        String   @default("")    // sigma | spl | kql | eql | yara-l | python | falco-yaml | wazuh-xml | pseudocode
  ruleType            String   @default("")    // detection | hunting | analytic | policy | correlation
  detectionLogicRaw   String   @default("")    // the actual rule body in its native language
  conversionSupported Boolean  @default(false) // true when ruleLanguage = sigma (Sigma CLI can convert)

  // ── Maturity / risk ──
  severity            String   @default("")    // info | low | medium | high | critical
  status              String   @default("")    // production | experimental | deprecated | community
  references          String   @default("[]")  // JSON array of URLs
  falsePositives      String   @default("[]")  // JSON

  // ── Source linking + change detection ──
  sourceFilePath      String   @default("")
  sourceUrl           String   @default("")
  rawPayload          String   @default("{}")  // full source-specific JSON for drill-down
  contentHash         String   @default("")    // for change detection across syncs
  changeStatus        String   @default("new") // new | modified | deleted | unchanged

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  source CommunitySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, sourceFilePath])
  @@index([sourceId])
  @@index([ruleLanguage])
  @@map("community_rules")
}

// Tracks Sigma CLI / pySigma conversion attempts (Phase 6 spike)
// Stored separately from CommunityRule so the original is never mutated.
model SigmaConversion {
  id              String   @id @default(uuid())
  sourceRuleId    String?  // CommunityRule.id OR CommunitySigmaRule.id (string ref, not FK)
  sourceTable     String   @default("community_sigma_rules") // which table the source came from
  inputYaml       String   // the sigma YAML that was converted
  targetBackend   String   // splunk | esql | elastic_lucene | kql | panther | etc
  outputFormat    String   @default("default")
  outputQuery     String   @default("")
  success         Boolean  @default(false)
  errorMessage    String?
  stderr          String   @default("")
  toolVersion     String   @default("")
  createdAt       DateTime @default(now())

  @@index([sourceRuleId])
  @@index([targetBackend])
  @@map("sigma_conversions")
}

model CommunitySigmaRule {
  id                     String   @id @default(uuid())
  sigmaId                String?
  title                  String
  description            String   @default("")
  status                 String   @default("")
  level                  String   @default("")
  tags                   String   @default("[]")        // JSON array
  logsourceCategory      String   @default("")
  logsourceProduct       String   @default("")
  logsourceService       String   @default("")
  detectionYaml          String                          // Full YAML content
  filePath               String
  repositoryUrl          String   @default("")
  author                 String   @default("")
  date                   String   @default("")
  modified               String   @default("")
  falsepositives         String   @default("[]")        // JSON array
  references             String   @default("[]")        // JSON array
  mitreTechniques        String   @default("[]")        // JSON array
  changeStatus           String   @default("new")       // new | modified | deleted | unchanged
  importStatus           String   @default("not_imported") // not_imported | imported | partial
  upstreamLastModifiedAt DateTime?
  contentHash            String   @default("")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  sourceId String
  source   CommunitySource @relation(fields: [sourceId], references: [id])

  @@unique([sourceId, filePath])
  @@index([sigmaId])
  @@index([title])
  @@index([level])
  @@index([changeStatus])
  @@index([importStatus])
  @@index([logsourceProduct])
  @@map("community_sigma_rules")
}

model CommunityElasticRule {
  id                     String   @id @default(uuid())
  ruleId                 String?                          // Elastic rule_id UUID
  name                   String
  description            String   @default("")
  severity               String   @default("")            // critical | high | medium | low
  riskScore              Int      @default(0)
  type                   String   @default("")            // query | eql | threshold | machine_learning
  language               String   @default("")            // kuery | eql | lucene
  query                  String   @default("")            // Detection query
  index                  String   @default("[]")          // JSON array of index patterns
  tags                   String   @default("[]")          // JSON array
  threat                 String   @default("[]")          // JSON array of MITRE threat mappings
  mitreTechniques        String   @default("[]")          // JSON array of technique IDs
  mitreTactics           String   @default("[]")          // JSON array of tactic names
  author                 String   @default("[]")          // JSON array of authors
  references             String   @default("[]")          // JSON array
  falsepositives         String   @default("[]")          // JSON array
  note                   String   @default("")            // Investigation guide
  setup                  String   @default("")            // Setup instructions
  ruleContent            String                           // Full TOML content
  filePath               String
  repositoryUrl          String   @default("")
  platform               String   @default("")            // windows | linux | macos | cross-platform | network
  maturity               String   @default("")            // production | development | deprecated
  integration            String   @default("[]")          // JSON array of required integrations
  createdDate            String   @default("")
  updatedDate            String   @default("")
  changeStatus           String   @default("new")         // new | modified | deleted | unchanged
  importStatus           String   @default("not_imported") // not_imported | imported | partial
  contentHash            String   @default("")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  sourceId String
  source   CommunitySource @relation(fields: [sourceId], references: [id])

  @@unique([sourceId, filePath])
  @@index([ruleId])
  @@index([name])
  @@index([severity])
  @@index([changeStatus])
  @@index([importStatus])
  @@index([platform])
  @@index([type])
  @@map("community_elastic_rules")
}

model SyncRun {
  id           String   @id @default(uuid())
  sourceId     String
  status       String   @default("running") // running | completed | failed
  newCount     Int      @default(0)
  modifiedCount Int     @default(0)
  deletedCount  Int     @default(0)
  totalAfterSync Int    @default(0)
  errorMessage String?
  startedAt    DateTime @default(now())
  completedAt  DateTime?

  @@map("sync_runs")
}

/// Phase 7 — Rule Workspace draft.
/// Carries an analyst's adapted detection from "candidate found" through
/// "PR opened" all the way to "merged into production repo".
model RuleDraft {
  id              String   @id @default(uuid())
  title           String
  notes           String   @default("")

  // Provenance — which upstream rule did this draft start from?
  // sourceTable identifies the catalog (community_rules, community_sigma_rules,
  // community_elastic_rules, splunk_detections, etc.) and sourceRuleId is the
  // primary key inside that table. Both nullable so analysts can author from
  // scratch.
  sourceTable     String?
  sourceRuleId    String?
  sourceName      String   @default("") // human-readable provenance label

  // Original (frozen at draft time) and adapted detection logic.
  originalLanguage String  @default("")  // sigma | kql | spl | yara-l | etc
  originalLogic    String  @default("")
  adaptedLanguage  String  @default("")
  adaptedLogic     String  @default("")

  // Sigma conversion target if the draft is the output of Sigma CLI.
  conversionTarget String? // splunk | esql | kql | panther | etc
  conversionToolVersion String @default("")

  // Lifecycle state.
  status          String   @default("draft") // draft | review | pr_open | merged | abandoned
  prNumber        Int?
  prUrl           String?
  prBranch        String?
  prRepo          String?  // owner/repo

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([sourceTable, sourceRuleId])
  @@map("rule_drafts")
}

/// Phase 8 — Workspace audit log. Records every meaningful workspace action
/// (draft created, draft updated, PR opened, PR merged, source refreshed,
/// rollback applied) so a senior detection engineer can reconstruct what
/// happened and when.
model WorkspaceAudit {
  id          String   @id @default(uuid())
  actor       String   @default("system")
  action      String   // draft.create | draft.update | draft.pr_open | source.refresh | source.rollback
  targetType  String   // draft | source | rule
  targetId    String?
  details     String   @default("{}") // JSON metadata
  success     Boolean  @default(true)
  errorMessage String?
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("workspace_audit")
}

model AtomicTest {
  id                String   @id @default(uuid())
  techniqueId       String                          // T1001, T1001.001
  techniqueName     String                          // display_name from YAML
  testNumber        Int                             // 1-based index
  testGuid          String   @default("")           // auto_generated_guid
  testName          String
  testDescription   String   @default("")
  platforms         String   @default("[]")         // JSON array: ["windows","linux"]
  elevationRequired Boolean  @default(false)
  executorName      String   @default("")           // command_prompt, powershell, bash, sh
  command           String   @default("")
  cleanupCommand    String   @default("")
  inputArguments    String   @default("{}")          // JSON object
  dependencies      String   @default("[]")         // JSON array
  tactic            String   @default("")           // MITRE tactic name
  sourceUrl         String   @default("")
  contentHash       String   @default("")
  source            String   @default("upstream")    // "upstream" (synced from redcanaryco) | "custom" (saved from the AtomicBuilder)
  createdBy         String   @default("")            // AuthUser.id for custom rows; "" for upstream
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([techniqueId, testNumber])
  @@index([techniqueId])
  @@index([techniqueName])
  @@index([tactic])
  @@index([executorName])
  @@index([elevationRequired])
  @@index([source])
  @@map("atomic_tests")
}

model AtomicSyncMeta {
  id              String    @id @default(uuid())
  status          String    @default("running")     // running | completed | failed
  newCount        Int       @default(0)
  updatedCount    Int       @default(0)
  removedCount    Int       @default(0)
  totalTechniques Int       @default(0)
  totalTests      Int       @default(0)
  commitSha       String    @default("")
  errorMessage    String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  @@map("atomic_sync_meta")
}

// ─── Use Case Builder (Phase 1) ──────────────────────────────────────────────
// A UseCase is a named, multi-step adversary scenario authored in one of three
// composition modes (atomic | purplesharp | canvas) and exportable as one or
// more Playbook artifacts (ART YAML, PurpleSharp JSON, Stratus shell). All
// fields use open-ended strings so new frameworks/modes/sources drop in
// without schema migrations.
model UseCase {
  id              String   @id @default(uuid())
  name            String
  description     String   @default("")
  authorMode      String   @default("atomic")     // "atomic" | "purplesharp" | "canvas"
  framework       String   @default("atomic")     // "atomic" | "purplesharp" | "stratus" | "mixed"
  source          String   @default("manual")     // "manual" | "ti" | "rule" | "upload"
  sourceRefType   String?
  sourceRefId     String?
  mitreTechniques String   @default("[]")
  mitreTactics    String   @default("[]")
  platforms       String   @default("[]")
  status          String   @default("draft")      // draft | ready | archived
  authorId        String   @default("")
  tags            String   @default("[]")
  steps           UseCaseStep[]
  playbooks       Playbook[]
  canvas          UseCaseCanvas?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([authorMode])
  @@index([framework])
  @@index([source])
  @@map("use_cases")
}

model UseCaseStep {
  id              String   @id @default(uuid())
  useCaseId       String
  useCase         UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  orderIndex      Int
  kind            String                                // "atomic" | "purplesharp" | "stratus" | "manual"
  refId           String   @default("")
  techniqueId     String   @default("")
  displayName     String
  parameters      String   @default("{}")              // per-step overrides JSON
  expectedSignal  String   @default("")
  notes           String   @default("")
  @@index([useCaseId, orderIndex])
  @@index([techniqueId])
  @@map("use_case_steps")
}

model Playbook {
  id              String   @id @default(uuid())
  useCaseId       String
  useCase         UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  format          String                                // "atomic-yaml" | "purplesharp-json" | "stratus-sh"
  version         Int      @default(1)
  body            String
  checksum        String   @default("")
  generator       String   @default("manual")          // "manual" | "anthropic" | "rule-mapper"
  generatorModel  String   @default("")
  createdAt       DateTime @default(now())
  @@index([useCaseId, format, version])
  @@map("playbooks")
}

model UseCaseCanvas {
  id              String   @id @default(uuid())
  useCaseId       String   @unique
  useCase         UseCase  @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  nodes           String   @default("[]")
  edges           String   @default("[]")
  layoutVersion   Int      @default(1)
  updatedAt       DateTime @updatedAt
  @@map("use_case_canvases")
}

model PurpleSharpVariation {
  id              String   @id @default(uuid())
  techniqueId     String
  techniqueName   String
  variation       Int
  variationLabel  String   @default("")
  requiresUrl     Boolean  @default(false)
  requiresCommand Boolean  @default(false)
  requiredParams  String   @default("[]")
  tactic          String   @default("")
  description     String   @default("")
  @@unique([techniqueId, variation])
  @@index([techniqueId])
  @@map("purplesharp_variations")
}

model PurpleSharpTemplate {
  id              String   @id @default(uuid())
  scenarioPath    String   @unique
  group           String   @default("")
  category        String   @default("")
  name            String
  description     String   @default("")
  rawJson         String
  mitreTechniques String   @default("[]")
  contentHash     String   @default("")
  sourceUrl       String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([group])
  @@map("purplesharp_templates")
}

model StratusAttack {
  id              String   @id @default(uuid())
  attackId        String   @unique
  name            String
  platform        String
  tactic          String   @default("")
  mitreTechniques String   @default("[]")
  description     String   @default("")
  prerequisites   String   @default("")
  detonateCmd     String   @default("")
  cleanupCmd      String   @default("")
  isIdempotent    Boolean  @default(true)
  sourceUrl       String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([platform])
  @@map("stratus_attacks")
}

// ─── Phase 4 — upload + cloud creds + Stratus execution ─────────────────────
// Custom detection upload. The file body is stored verbatim so the user can
// inspect what was uploaded; parser output goes in `parsedTechniques` etc.
model UploadedDetection {
  id              String   @id @default(uuid())
  filename        String
  format          String                                // sigma | spl | elastic-toml | kql | yaml-unknown
  rawContent      String
  parsedTechniques String  @default("[]")
  parsedTactics   String   @default("[]")
  parsedLogsource String   @default("")                // free-form log source label
  // suggested {atomic:[techniqueIds], purplesharp:[techniqueIds], stratus:[attackIds]}
  inferredMappings String  @default("{}")
  // FK string into UseCase once materialised. We don't add a relation here so
  // the upload row survives UseCase archive/delete operations.
  useCaseId       String?
  uploadedBy      String   @default("")
  createdAt       DateTime @default(now())
  @@index([uploadedBy])
  @@index([format])
  @@map("uploaded_detections")
}

// AES-GCM-encrypted cloud credentials for the Stratus runtime.
// `accessKeyId`/`secretKey`/`sessionToken` are base64 of {nonce|ciphertext|tag}
// where the AEAD key is derived from CREDENTIAL_VAULT_KEY via scrypt.
// GET endpoints never decrypt — they return label + provider only.
model CloudCredential {
  id              String   @id @default(uuid())
  provider        String                                // aws | azure | gcp | kubernetes | entra-id
  label           String                                // user-given name
  accessKeyId     String   @default("")
  secretKey       String   @default("")
  sessionToken    String   @default("")
  configJson      String   @default("{}")              // provider-specific extras (region, subscription, …)
  ownerId         String   @default("")
  lastUsedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([provider])
  @@index([ownerId])
  @@map("cloud_credentials")
}

// One per (phase, attack) execution. logs stream as the subprocess emits.
model StratusExecution {
  id              String   @id @default(uuid())
  useCaseId       String?                               // optional FK string into UseCase
  stepId          String?                               // optional FK string into UseCaseStep
  attackId        String                                // e.g. aws.credential-access.ec2-get-password-data
  credentialId    String?                               // FK string into CloudCredential
  phase           String                                // warmup | detonate | cleanup | dry-run
  status          String   @default("queued")          // queued | running | success | failure | timeout
  exitCode        Int?
  logs            String   @default("")
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  durationMs      Int      @default(0)
  actor           String   @default("")
  @@index([useCaseId, attackId])
  @@index([credentialId])
  @@index([status, startedAt])
  @@map("stratus_executions")
}

// ─── AI generation log (Phase 2) ─────────────────────────────────────────────
// Every Anthropic invocation gets a row: which generator + model + input ref +
// token usage. The optional FK to UseCase lets us trace a UseCase back to the
// generation(s) that produced it (one for "from-ti" + one for each format).
model AiGeneration {
  id              String   @id @default(uuid())
  useCaseId       String?
  generator       String                                // "atomic-from-prompt" | "ti-to-playbook" | "rule-to-playbook" | "detection-samples"
  model           String                                // claude-opus-4-7 | claude-sonnet-4-6
  inputRefType    String                                // "Prompt" | "ThreatIntelReport" | "CommunityRule" | ...
  inputRefId      String                                // user id / report id / rule id
  promptVersion   String                                // "ti-to-playbook@v1"
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  costUsd         Float    @default(0)
  toolName        String   @default("")
  toolCalls       String   @default("[]")
  rawResponse     String   @default("")
  status          String   @default("ok")              // ok | error | rejected
  errorMessage    String?
  createdAt       DateTime @default(now())
  @@index([generator, createdAt])
  @@index([inputRefType, inputRefId])
  @@index([useCaseId])
  @@map("ai_generations")
}

// ─── Unified event log (audit + execution log) ───────────────────────────────
// Every meaningful action in the app lands here:
//   - auth.signup / auth.login / auth.verify / auth.logout
//   - sigma.convert / sigma.detect
//   - simulation.start / simulation.complete / simulation.chain_persist
//   - detection.validate
//   - report.create / report.github_push
//   - build.run / build.download
//   - lab.deploy / lab.lifecycle
//   - integration.test / integration.update
//   - workspace.* (mirrored from WorkspaceAudit for unified querying)
// Kept additive: existing WorkspaceAudit table stays for backwards-compat.
model EventLog {
  id           String   @id @default(uuid())
  ts           DateTime @default(now())
  category     String                              // auth | sigma | simulation | detection | report | build | lab | integration | workspace | other
  action       String                              // dotted name within category
  actor        String   @default("system")         // userId or "system" / "anonymous"
  status       String   @default("ok")             // ok | error | warn | info
  targetType   String?                             // simulation | draft | report | repo | …
  targetId     String?
  durationMs   Int      @default(0)
  message      String   @default("")
  details      String   @default("{}")             // JSON object — caller-defined context
  errorMessage String?
  requestId    String?                             // optional correlation id

  @@index([category, ts])
  @@index([action, ts])
  @@index([actor, ts])
  @@index([targetType, targetId])
  @@index([ts])
  @@map("event_log")
}

// ─── Auth (landing-page sign-up / sign-in / email verification) ──────────────
// Minimal local auth: passwords hashed with scrypt (node:crypto), sessions
// tracked in DB with an HTTP-only cookie. Email verification uses a 6-digit
// code; since there's no SMTP configured, the code is also returned in the
// signup response under `__devCode` for development workflows.
model AuthUser {
  id                  String              @id @default(uuid())
  email               String              @unique
  name                String              @default("")
  passwordHash        String              // scrypt(saltBase64:hashBase64)
  emailVerified       Boolean             @default(false)
  emailVerifiedAt     DateTime?
  role                String              @default("engineer")   // engineer | admin
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  sessions            AuthSession[]
  verifications       EmailVerification[]

  @@map("auth_users")
}

model AuthSession {
  id          String   @id @default(uuid())
  token       String   @unique
  userId      String
  user        AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  userAgent   String   @default("")
  ip          String   @default("")

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model EmailVerification {
  id          String    @id @default(uuid())
  userId      String
  user        AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash    String    // scrypt of 6-digit numeric code
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_email_verifications")
}

model SimulationRun {
  id              String    @id @default(uuid())
  techniqueIds    String                            // JSON array of technique IDs
  targetServer    String                            // VM name
  targetIp        String    @default("")
  source          String    @default("local")       // local | cloud | fleet | c2 — which environment ran it
  executor        String    @default("")            // art | caldera
  parameters      String    @default("{}")          // JSON object
  status          String    @default("queued")      // queued | running | success | failure | error
  logs            String    @default("")
  errorMessage    String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  durationMs      Int       @default(0)
  // Full simulation+detection chain — written once detection validation completes,
  // so the History tab can re-display detection outputs and re-export reports
  // without depending on transient React state.
  executionMode         String    @default("simulation")  // "simulation" | "simulation_detection"
  selectedDetections    String    @default("[]")          // JSON array of SplunkDetectionOption snapshots
  detectionResults      String    @default("[]")          // JSON array of DetectionResult per detection
  splunkUrl             String    @default("")
  maxRetries            Int       @default(20)
  validationCompletedAt DateTime?

  @@index([status])
  @@index([startedAt])
  @@map("simulation_runs")
}

model SplunkDetection {
  id                String   @id @default(uuid())
  detectionId       String   @unique                     // UUID from YAML id field
  name              String
  description       String   @default("")
  author            String   @default("")
  date              String   @default("")                 // last updated date from YAML
  status            String   @default("")                 // production | deprecated | experimental
