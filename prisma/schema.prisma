model BuildRepo {
  id                 String   @id @default(uuid())
  name               String   @unique                        // short name for UI / API
  owner              String                                  // GitHub org or user
  repoName           String                                  // GitHub repo name
  gitUrl             String                                  // https://github.com/owner/repo.git
  visibility         String   @default("public")             // public | private
  description        String   @default("")
  language           String   @default("")                   // go | rust | python | cpp | dotnet | node
  buildSystem        String   @default("")                   // go | make | cmake | cargo | npm | pip
  defaultBranch      String   @default("main")
  allowedBranches    String   @default("[\"main\"]")         // JSON array
  targets            String   @default("[]")                 // JSON array of target definitions
  defaultEnvironment String   @default("linux")
  defaultArch        String   @default("x64")
  framework          String   @default("custom")             // sigma | splunk | elastic | osquery | custom
  avatarUrl          String   @default("")
  stars              Int      @default(0)
  enabled            Boolean  @default(true)
  lastSyncedAt       DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Additive fields (Phase 1: Offensive Tools seed). Optional with safe defaults
  // so any existing code that doesn't read them keeps working unchanged.
  category           String   @default("")                   // e.g. "credential-access", "command-and-control"
  mitreTechniques    String   @default("[]")                 // JSON array of MITRE technique IDs ("T1558.003")
  riskLevel          String   @default("low")                // low | medium | high
  // Snapshot of the repo's GitHub Release / meta-repo prebuilt status, populated
  // at seed time. UI uses this to show "Prebuilt available" and switch the
  // primary action button between Download and Build. JSON shape:
  //   { available: bool, kind: "release-assets" | "meta-repo" | "branch-zip" | "none",
  //     tag?: str, assetCount?: int, primaryAssetName?: str,
  //     primaryAssetUrl?: str, primaryAssetSize?: int, lastChecked: ISO8601 }
  prebuiltInfo       String   @default("{}")

  builds BuildRecord[]

  @@index([owner])
  @@index([language])
  @@index([framework])
  @@index([enabled])
  @@index([category])
  @@map("build_repos")
}

